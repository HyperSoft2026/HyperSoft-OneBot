# ========================================================
# OneBot by HyperSoft - Environment Configuration Example
# ========================================================
# IMPORTANT: Never commit actual secret values to version control.
# Copy this file to .env and provide your actual credentials.

# --- Discord Bot Core Credentials (Required) ---
# Your Discord Bot Token from Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=

# Your Discord Application / Client ID from Discord Developer Portal -> General Information
DISCORD_CLIENT_ID=

# Your Discord OAuth2 Client Secret (Used ONLY for Dashboard OAuth2 / API)
DISCORD_CLIENT_SECRET=

# --- Compliance & Legal URLs (Optional but Recommended) ---
# Link to your Privacy Policy document or website
PRIVACY_POLICY_URL=

# Link to your Terms of Service document or website
TERMS_OF_SERVICE_URL=

# --- Persistent Database Configuration ---
# MongoDB Connection URI (e.g., mongodb+srv://... or mongodb://localhost:27017/onebot)
# If left empty, OneBot automatically uses local JSON database fallback in ./database/guilds/
MONGODB_URI=

# --- Dashboard & Server Configuration ---
# Web Dashboard HTTP Port (Default: 3000)
PORT=

# Secret key used for signing session cookies in the Dashboard
SESSION_SECRET=
